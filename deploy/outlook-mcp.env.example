# Non-secret settings for outlook-mcp. Installed as /etc/outlook-mcp/outlook-mcp.env
# The client secret, MCP token, vault key and Microsoft refresh token are NOT
# here: the first three are TPM-sealed credentials (seal-credential.sh), the
# refresh token is in the encrypted vault (see README).
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Must exactly match a redirect URI registered on the app under the "Web"
# platform (including any port or path), e.g. http://localhost:8400/callback
#MS_REDIRECT_URI=http://localhost

# What the agent may do
#ENABLE_WRITE_TOOLS=true      # false = no drafts, no mark read/flag/move/categories
#ENABLE_SEND_TOOLS=true       # false = never send: the agent can only leave drafts
#SEND_CONFIRMATION=client     # client = the MCP client's own approval prompt;
                              # elicit = this server asks you to approve every send
                              # (recipients, subject and text shown) and refuses if
                              # the client can't show the prompt
#SEND_ALLOWED_DOMAINS=        # e.g. contoso.com,partner.com: refuse to send elsewhere
                              # (drafts are still allowed). Empty = any domain.
#SIGNATURE_FILE=/etc/outlook-mcp/signature.html   # appended to new mail, replies and
                              # forwards (.html/.htm as HTML, anything else as text)

# Calendar (needs the Calendars.ReadWrite permission)
#ENABLE_CALENDAR_TOOLS=true  # false = no calendar tools
#TIMEZONE=Asia/Dubai          # IANA zone for calendar times; empty = your Outlook
                              # setting (needs MailboxSettings.Read), else UTC
#WORKING_HOURS=08:00-17:00    # find_free_time default; empty = your Outlook setting
#WORKING_DAYS=mon-fri         # e.g. sun-thu; empty = your Outlook setting

# Optional
#KEEPALIVE_HOURS=12           # background refresh so the sign-in doesn't age out; 0 = off
#MAX_BODY_CHARS=20000         # default cut-off for message bodies in get_message
#MAX_ATTACHMENT_MB=25         # largest attachment get_attachment will download
